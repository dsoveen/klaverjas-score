rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alleen jij (ingelogd met dit e-mailadres) mag het overzicht lezen en bijwerken.
    // Vervang het adres door het e-mailadres van je Firebase-gebruiker.
    match /games/{potje} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'JOUW@EMAILADRES.NL';
    }
  }
}
